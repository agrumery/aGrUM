#ifndef GUM_PUBLIC_CM
#  if defined(_WIN32)
#    if defined(AGRUM_CM_EXPORTING)
#      define GUM_PUBLIC_CM __declspec(dllexport)
#    else
#      define GUM_PUBLIC_CM __declspec(dllimport)
