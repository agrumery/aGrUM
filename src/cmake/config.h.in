#  endif
#endif

#ifndef GUM_PUBLIC_ID
#  if defined(_WIN32)
#    if defined(AGRUM_ID_EXPORTING)
#      define GUM_PUBLIC_ID __declspec(dllexport)
#    else
#      define GUM_PUBLIC_ID __declspec(dllimport)
#    endif
#  elif defined(__GNUC__) || defined(__clang__)
#    define GUM_PUBLIC_ID __attribute__((visibility("default")))
#  else
