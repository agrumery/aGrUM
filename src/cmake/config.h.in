#  endif
#endif

#ifndef GUM_PUBLIC_FMDP
#  if defined(_WIN32)
#    if defined(AGRUM_FMDP_EXPORTING)
#      define GUM_PUBLIC_FMDP __declspec(dllexport)
#    else
#      define GUM_PUBLIC_FMDP __declspec(dllimport)
#    endif
#  elif defined(__GNUC__) || defined(__clang__)
#    define GUM_PUBLIC_FMDP __attribute__((visibility("default")))
#  else
