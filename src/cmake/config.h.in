// This file is generated by cmake.
// Please do not change its content.
// Please do not add it to the repository.

// To ease the process (especially for pyAgrum and other apps which directly
// use agrum source instead of linking with agrum shared library), this file is
// generated in source directory :
// it should not be different between release and debug versions

#ifndef GUM_CONFIG_H
#define GUM_CONFIG_H

#define GUM_MAJOR_VERSION ${GUM_MAJOR_VERSION}
#define GUM_MINOR_VERSION ${GUM_MINOR_VERSION}
#define GUM_PATCH_VERSION ${GUM_PATCH_VERSION}

#define GUM_RANDOMSEED ${GUM_RANDOMSEED}

#cmakedefine GUM_SRC_PATH @GUM_SRC_PATH@
#define GUM_VERSION @GUM_VERSION@

#cmakedefine GUM_TRACE_ON

#cmakedefine GUM_CHAR_SIZE   @GUM_CHAR_SIZE@
#cmakedefine GUM_INT_SIZE    @GUM_INT_SIZE@
#cmakedefine GUM_LONG_SIZE   @GUM_LONG_SIZE@
#cmakedefine GUM_FLOAT_SIZE  @GUM_FLOAT_SIZE@
#cmakedefine GUM_DOUBLE_SIZE @GUM_DOUBLE_SIZE@

#cmakedefine HAVE_MKSTEMP 1
#cmakedefine HAVE_DIRENT_H 1
#cmakedefine HAVE_UNISTD_H 1
#cmakedefine HAVE_SYS_TIME_H 1
#cmakedefine HAVE_EXECINFO_H 1

#cmakedefine GUM_THREADS         @GUM_THREADS@


#define GUM_AT_LEAST(x,y,z) (GUM_MAJOR_VERSION>x || (GUM_MAJOR_VERSION>=x && \
                             (GUM_MINOR_VERSION>y || (GUM_MINOR_VERSION>=y && \
                                 GUM_PATCH_VERSION>=z))))

#ifdef __GNUC__
#define GNUC_AT_LEAST(x,y) ((__GNUC__==x && __GNUC_MINOR__>=y) || __GNUC__>x)
#else
#define GNUC_AT_LEAST(x,y) 0
#endif

#ifdef __GNUC__
#define GNUC_AT_MOST(x,y) ((__GNUC__==x && __GNUC_MINOR__<=y) || __GNUC__<x)
#else
#define GNUC_AT_MOST(x,y) 0
#endif

#ifdef __GNUC__
#define GUM_DEPRECATED(func) func __attribute__ ((deprecated))
#elif defined(_MSC_VER)
#define GUM_DEPRECATED(func) __declspec(deprecated) func
#else
#pragma message("WARNING: You need to implement DEPRECATED for this compiler")
#define GUM_DEPRECATED(func) func
#endif

#define GUM_UNUSED(expr) do { (void)(expr); } while (0)

// Windows PE targets (MSVC AND MinGW-w64) both need dllexport/dllimport: GCC's
// visibility("default") attribute only controls symbol binding on ELF/Mach-O --
// on PE it is not translated into an export-table entry at all, so gating this on
// _MSC_VER alone (leaving MinGW, which also defines __GNUC__, to fall through to
// the visibility branch) silently produced a _pyagrum.dll that exported nothing,
// breaking every leaf module's cross-DLL import on MinGW while MSVC (and
// Linux/macOS, genuinely ELF/Mach-O) stayed fine. _WIN32 is the actual target
// check (defined by both toolchains) and is what portable dllexport/dllimport
// macros key off; see e.g. https://gcc.gnu.org/wiki/Visibility.
#ifndef GUM_PUBLIC
#  if defined(_WIN32)
#    define GUM_PUBLIC __declspec(dllexport)
#  elif defined(__GNUC__) || defined(__clang__)
#    define GUM_PUBLIC __attribute__((visibility("default")))
#  else
#    define GUM_PUBLIC
#  endif
#endif

#ifndef PYGUM_PUBLIC
#  if defined(_WIN32)
#    define PYGUM_PUBLIC __declspec(dllexport)
#  elif defined(__GNUC__) || defined(__clang__)
#    define PYGUM_PUBLIC __attribute__((visibility("default")))
#  else
#    define PYGUM_PUBLIC
#  endif
#endif

// PYGUM_SHARED_PUBLIC tags BASE/BN symbols that pyAgrum leaf modules (PRM/CN/ID/MRF/CM)
// need but that live in BASE/BN's own object files, embedded once into core _pyagrum
// (see wrappers/pyagrum/CMakeLists.txt). Unlike PYGUM_PUBLIC (self-contained: producer
// and only consumer are the same target), these symbols are declared by every consumer
// via shared headers. On Windows (MSVC and MinGW alike), __declspec(dllexport) must
// only be used by the TU that actually owns/defines the symbol (agrumBASE/agrumBN, see
// PYGUM_SHARED_EXPORTING in src/cmake/Modules.agrum.cmake) -- every other TU that
// includes the same header must see dllimport instead, or the linker emits its own
// local dllexport'd definition too, producing a duplicate-symbol link error (LNK2005
// on MSVC) once linked against core's import library. GCC/Clang's visibility("default")
// has no such asymmetry on genuine ELF/Mach-O targets: it only says "don't hide this
// symbol", so no producer/consumer distinction is needed there -- but MinGW is a PE
// target like MSVC (see the _WIN32 note above GUM_PUBLIC), so it needs the same
// dllexport/dllimport split, not the ELF-only visibility attribute.
//
// The producer/consumer split only makes sense for pyAgrum builds (GUM_FOR_SWIG,
// defined iff BUILD_PYTHON, CMakeLists.txt) -- that's the only context where BASE/BN
// get embedded into one binary (core _pyagrum) while every other consumer is a
// separately-linked .pyd. Plain aGrUM (BUILD_PYTHON=OFF) never defines
// PYGUM_SHARED_EXPORTING anywhere, including on agrumBASE/agrumBN themselves, so
// without this GUM_FOR_SWIG guard every tagged symbol -- even in the TU that defines
// it -- would resolve to dllimport, producing MSVC C4273 ("inconsistent dll linkage")
// on the very definition. Outside GUM_FOR_SWIG, fall back to plain dllexport (same as
// GUM_PUBLIC): a single library, no cross-.pyd split, nothing to import from.
#ifndef PYGUM_SHARED_PUBLIC
#  if defined(_WIN32)
#    if defined(GUM_FOR_SWIG) && !defined(PYGUM_SHARED_EXPORTING)
#      define PYGUM_SHARED_PUBLIC __declspec(dllimport)
#    else
#      define PYGUM_SHARED_PUBLIC __declspec(dllexport)
#    endif
#  elif defined(__GNUC__) || defined(__clang__)
#    define PYGUM_SHARED_PUBLIC __attribute__((visibility("default")))
#  else
#    define PYGUM_SHARED_PUBLIC
#  endif
#endif

// GUM_PUBLIC_<MODULE> is the producer/consumer split for GUM_PUBLIC (pure aGrUM's
// full public C++ API, Phase 6 of GUM_PUBLIC.md), one macro per module rather than
// a single shared name. Unlike PYGUM_SHARED_PUBLIC/PYGUM_SHARED_EXPORTING (which
// only ever needed to distinguish BASE/BN as sole owner from every other consumer,
// because pyAgrum whole-archives BASE/BN into one core binary), aGrUM's own pure
// build links its 8 modules as genuinely separate shared libraries by default
// (BUILD_SHARED_LIBS=ON, CMakeLists.txt) -- each module is simultaneously a
// producer of its own symbols and a consumer of its dependencies' symbols. A single
// macro name can't express that: its expansion is fixed by what's #define'd in the
// compiling TU, not by which module's header declared the symbol, so one name would
// have no way to tell "I own this" from "I merely include the header that declares
// it" when both happen in the same TU. Each AGRUM_<MODULE>_EXPORTING flag is set
// unconditionally on its own module's CMake target (Modules.agrum.cmake), so unlike
// PYGUM_SHARED_EXPORTING (gated on BUILD_PYTHON, see GUM_PUBLIC.md §13's C4273),
// there is no context where a module fails to see its own exporting flag -- no
// GUM_FOR_SWIG guard is needed here.
//
// Scope: non-template classes/functions only. On MSVC/MinGW, GUM_NO_EXTERN_TEMPLATE_CLASS
// (CMakeLists.txt) already disables the extern-template-pair mechanism entirely
// (C4910: dllexport + extern template are incompatible), so these macros must never
// be applied to a template still generic in its declaration -- see GUM_PUBLIC.md
// §11-12 for the C2491 failure mode this would otherwise reproduce.
// GUM_SHARED_PUBLIC (not GUM_PUBLIC_BASE): BASE is the root of the module
// dependency graph (BASE_DEPS is empty, src/modules.txt) -- it never consumes
// another module's GUM_PUBLIC_<MODULE>-tagged symbols, only produces its own, so
// it plays exactly the role BASE/BN played for PYGUM_SHARED_PUBLIC (a pure
// producer, uniformly consumed elsewhere): a single unqualified name is safe here.
// This does NOT generalize to the other 7 modules -- BN, for instance, both
// produces its own symbols and consumes BASE's GUM_SHARED_PUBLIC ones in the same
// .cpp files, so it cannot reuse this bare name without recreating the exact
// single-token asymmetry bug the per-module split (GUM_PUBLIC_<MODULE> family,
// below) exists to avoid. Each non-BASE module gets its own name when its turn
// in the rollout comes.
//
// For *standalone* aGrUM (BUILD_SHARED_LIBS=ON, 8 separate module .dll/.so),
// BN genuinely is a different DLL from BASE, so BN must see dllimport for
// BASE's GUM_SHARED_PUBLIC symbols -- the plain GUM_SHARED_EXPORTING check
// below is correct there. But for pyAgrum builds (GUM_FOR_SWIG), BASE and BN
// are both whole-archived into the very same binary (core _pyagrum, see
// Modules.agrum.cmake's _IS_BASE_OR_BN), so BN's dllimport reference to a
// GUM_SHARED_PUBLIC symbol BASE defines in that *same* link never crosses a
// real DLL boundary. MSVC's link.exe tolerates that (LNK4217 warning,
// auto-resolves); GNU ld (MinGW) does not -- it demands a real import library
// backing every __imp_* thunk, failing with "undefined reference to
// __imp_..." for every GUM_SHARED_PUBLIC symbol BN's own .cpp files call into
// BASE for. PYGUM_SHARED_EXPORTING is already defined for BASE *and* BN
// together whenever GUM_FOR_SWIG is set (Modules.agrum.cmake) -- reusing it
// here as an extra dllexport condition, gated on GUM_FOR_SWIG so
// standalone-build behavior is untouched, closes the gap without duplicating
// the BASE/BN pairing logic it already encodes.
#ifndef GUM_SHARED_PUBLIC
#  if defined(_WIN32)
#    if defined(GUM_SHARED_EXPORTING) || (defined(GUM_FOR_SWIG) && defined(PYGUM_SHARED_EXPORTING))
#      define GUM_SHARED_PUBLIC __declspec(dllexport)
#    else
#      define GUM_SHARED_PUBLIC __declspec(dllimport)
#    endif
#  elif defined(__GNUC__) || defined(__clang__)
#    define GUM_SHARED_PUBLIC __attribute__((visibility("default")))
#  else
#    define GUM_SHARED_PUBLIC
#  endif
#endif

#ifndef GUM_PUBLIC_BN
#  if defined(_WIN32)
#    if defined(AGRUM_BN_EXPORTING)
#      define GUM_PUBLIC_BN __declspec(dllexport)
#    else
#      define GUM_PUBLIC_BN __declspec(dllimport)
#    endif
#  elif defined(__GNUC__) || defined(__clang__)
#    define GUM_PUBLIC_BN __attribute__((visibility("default")))
#  else
#    define GUM_PUBLIC_BN
#  endif
#endif

#ifndef GUM_PUBLIC_PRM
#  if defined(_WIN32)
#    if defined(AGRUM_PRM_EXPORTING)
#      define GUM_PUBLIC_PRM __declspec(dllexport)
#    else
#      define GUM_PUBLIC_PRM __declspec(dllimport)
#    endif
#  elif defined(__GNUC__) || defined(__clang__)
#    define GUM_PUBLIC_PRM __attribute__((visibility("default")))
#  else
#    define GUM_PUBLIC_PRM
#  endif
#endif

#ifndef GUM_PUBLIC_MRF
#  if defined(_WIN32)
#    if defined(AGRUM_MRF_EXPORTING)
#      define GUM_PUBLIC_MRF __declspec(dllexport)
#    else
#      define GUM_PUBLIC_MRF __declspec(dllimport)
#    endif
#  elif defined(__GNUC__) || defined(__clang__)
#    define GUM_PUBLIC_MRF __attribute__((visibility("default")))
#  else
#    define GUM_PUBLIC_MRF
#  endif
#endif

#ifndef GUM_PUBLIC_CN
#  if defined(_WIN32)
#    if defined(AGRUM_CN_EXPORTING)
#      define GUM_PUBLIC_CN __declspec(dllexport)
#    else
#      define GUM_PUBLIC_CN __declspec(dllimport)
#    endif
#  elif defined(__GNUC__) || defined(__clang__)
#    define GUM_PUBLIC_CN __attribute__((visibility("default")))
#  else
