
html.dark-mode div.fragment, html.dark-mode pre.fragment {
	margin: 0;
	padding: 4px;
}

/*********************************************/
/**               Main content              **/
/*********************************************/
html.dark-mode .contents {
	margin: 10px auto !important;
	padding: 0 10px;
	max-width: 1200px;
}

/*********************************************/
/**               Inline code               **/
/*********************************************/
html.dark-mode p code,
html.dark-mode li code,
html.dark-mode td code,
html.dark-mode dd code {
	display: inline;
	padding: 0px 6px;
	-webkit-border-radius: 4px;
	-moz-border-radius: 4px;
	border-radius: 4px;

	background-color: #CCCCCC;
	border: 1px solid #333333;

	color: #333333;
}

/*********************************************/
/**         Table of Contents (ToC)         **/
/*********************************************/
html.dark-mode div.toc {
	margin: 0 !important;
	border-radius: 4px !important;
}

html.dark-mode div.toc h3 {
	font-size: 150%;
	color: inherit;
}

/*********************************************/
/**              Content table              **/
/*********************************************/
html.dark-mode .contents table.doxtable {
	margin: 0 auto;
}

/*********************************************/
/**               Field table               **/
/*********************************************/
html.dark-mode .fieldtable {
	box-shadow: none !important;
	-webkit-box-shadow: none;
	-moz-box-shadow: none;
}

/*********************************************/
/**           Memitem and memtitle          **/
/*********************************************/
html.dark-mode .memitem,
html.dark-mode .memproto,
html.dark-mode .memdoc {
	box-shadow: none;
	-webkit-box-shadow: none;
	-moz-box-shadow: none;
	background-image: none;
}

/*********************************************/
/**             TOP navigation              **/
/*********************************************/
html.dark-mode .tablist a:hover,
html.dark-mode .tablist li.current a {
	text-shadow: none;
	-moz-text-shadow: none;
	-webkit-text-shadow: none;
}

/*********************************************/
/**              H1 in textblocks           **/
/*********************************************/
html.dark-mode .textblock h1 {
    border-bottom: 1px solid #32363d;
    border-left: 3px solid #32363d;
    margin: 40px 0px 10px 0px;
    padding-bottom: 10px;
    padding-top: 10px;
    padding-left: 5px;
}

html.dark-mode .textblock h1:first-child {
	margin-top: 10px;
}

/*********************************************/
/**               Note, warning             **/
/*********************************************/
html.dark-mode dl.note,
html.dark-mode dl.warning,
html.dark-mode dl.todo,
html.dark-mode dl.deprecated,
html.dark-mode dl.reflist {
	border: 0;
	padding: 0px;
	margin: 4px 0px 4px 0px;
	border-radius: 4px;
}

html.dark-mode dl.note dt,
html.dark-mode dl.warning dt,
html.dark-mode dl.todo dt,
html.dark-mode dl.deprecated dt,
html.dark-mode dl.reflist dt {
	margin: 0;
	font-size: 14px;
	padding: 2px 4px;

	border: none;
	border-top-left-radius: 0px;
	border-top-right-radius:0px;

	font-weight: bold;
	text-transform: uppercase;
	color: #FFFFFF !important;

	box-shadow: none;
	-webkit-box-shadow: none;
	-moz-box-shadow: none;
	text-shadow: none;
}

html.dark-mode dl.note dd,
html.dark-mode dl.warning dd,
html.dark-mode dl.todo dd,
html.dark-mode dl.deprecated dd,
html.dark-mode dl.reflist dd {
	margin: 0;
	padding: 4px;
	background: none;

	color: #222222;

	border: 1px solid;
	border-bottom-left-radius: 0px;
	border-bottom-right-radius: 0px;
	border-top: none;

	box-shadow: none;
	-webkit-box-shadow: none;
	-moz-box-shadow: none;
	text-shadow: none;
}

html.dark-mode dl.reflist dd {
	margin-bottom: 15px;
}

/* Header */
html.dark-mode dl.note dt {
	background-color: #cbc693;
}

html.dark-mode dl.warning dt {
	background-color: #bf5f82;
}

html.dark-mode dl.todo dt {
	background-color: #82b3c9;
}

html.dark-mode dl.deprecated dt {
	background-color: #af8eb5;
}

html.dark-mode dl.reflist dt {
	background-color: #cbae82;
}

/* Content */
html.dark-mode dl.note dd {
	background-color: #fff9c4;
	border-color: #cbc693;
}

html.dark-mode dl.warning dd {
	background-color: #f48fb1;
	border-color: #bf5f82;
}

html.dark-mode dl.todo dd {
	background-color: #b3e5fc;
	border-color: #82b3c9;
}

html.dark-mode dl.deprecated dd {
	background-color: #e1bee7;
	border-color: #af8eb5;
}

html.dark-mode dl.reflist dd {
	background-color: #ffe0b2;
	border-color: #cbae82;
}

/*********************************************/
/**               Note, warning             **/
/*********************************************/
html.dark-mode #docs_list {
	padding: 0 10px;
}

html.dark-mode #docs_list ul {
	margin: 0;
	padding: 0;
	list-style: none;
}

html.dark-mode #docs_list ul li {
	display: inline-block;
	border-right: 1px solid #BFBFBF;
}

html.dark-mode #docs_list ul li:last-child {
	border-right: none;
}

html.dark-mode #docs_list ul li a {
	display: block;
	padding: 8px 13px;
	font-weight: bold;
	font-size: 15px;
}

html.dark-mode #docs_list ul li a:hover,
html.dark-mode #docs_list ul li a.docs_current {
	text-decoration: underline;
}

/*********************************************/
/**               Resizable UI              **/
/*********************************************/
html.dark-mode .ui-resizable-e {
	width: 3px;
}

/*********************************************/
/**               Download url              **/
/*********************************************/
html.dark-mode .download_url {
	font-weight: bold;
	font-size: 150%;
	line-height: 150%;
}

/*********************************************/
/**               Syntax folor              **/
/*********************************************/
html.dark-mode div.line a {
	text-decoration: underline;
}

html.dark-mode span.lineno a {
	text-decoration: none;
}

/*********************************************/
/**          Modules/Directory table        **/
/*********************************************/
html.dark-mode .directory .arrow {
	height: initial;
}

html.dark-mode .directory td.entry {
	padding: 3px 6px;
}

/*********************************************/
/**                 Mem items               **/
/*********************************************/
html.dark-mode .memproto table td {
	font-family: monospace, fixed !important;
}

html.dark-mode td.memItemLeft, html.dark-mode td.memItemRight {
	font-family: monospace, fixed;
}

html.dark-mode .paramname, html.dark-mode .paramname em {
	font-style: italic;
}

html.dark-mode .memdoc {
	text-shadow: none;
}

html.dark-mode .memItem {
	font-family: monospace, fixed;
}

html.dark-mode .memItem table {
	font-family: inherit;
}

/*********************************************/
/**                 Footer                  **/
/*********************************************/
html.dark-mode img.footer {
	height: 22px;
}

/*********************************************/
/**             Custom scrollbar            **/
/*********************************************/

/* Light background: #3 5 3 6 2 9; */
/* New light dark background #3 2 3 6 3 d */
/* Dark background: #d f e 5 f 2; */


html.dark-mode .sm-dox a {
	background: none;
}

html.dark-mode body {
	background: #282923;
	background-image: none;
	color: #D8D8D8;
}

html.dark-mode div.fragment, html.dark-mode pre.fragment {
	border: 1px solid #000000;
	background: #32363d;
}

html.dark-mode a, html.dark-mode a:link, html.dark-mode a:visited {
	color: #67d8ef !important;
}

html.dark-mode .highlighted {
	background: none !important;
}

html.dark-mode a.highlighted {
	background: none !important;
}

/*********************************************/
/**              Top main menu              **/
/*********************************************/
html.dark-mode #main-nav {
	/* display: none; */
	border-bottom: 1px solid #32363d;
}

html.dark-mode #main-nav .sm-dox {
	background: #32363d !important;
}

html.dark-mode .sm-dox a {
	text-shadow: none !important;
	background: transparent !important;
}

html.dark-mode .sm-dox a:hover {
	background: #282923 !important;
}

html.dark-mode .sm-dox {
	text-shadow: none !important;
	box-shadow: none !important;
}

html.dark-mode .sm-dox ul {
	border: 1px solid #000000;
	background: #32363d;
}

html.dark-mode .directory tr.even {
	background: #32363d;
}

/*********************************************/
/**         Top main menu (light mode)      **/
/*********************************************/
html.light-mode #titlearea {
	background: #eef1f7;
}

html.light-mode #main-nav .sm-dox {
	background: #dfe5f2;
}

html.light-mode .sm-dox ul {
	background: #dfe5f2;
}


/*********************************************/
/**               Top search                **/
/*********************************************/
html.dark-mode #MSearchSelectWindow {
	border: 1px solid #000000;
	background: #32363d;
}

html.dark-mode a.selectItem {
	padding: 3px;
}

html.dark-mode a.SelectItem:hover {
	background: #282923 !important;
}

html.dark-mode #MSearchResultsWindow {
	border: 1px solid #000000;
	background: #32363d;
	color: #67d8ef !important;;
}

/*********************************************/
/**                Main menu                **/
/*********************************************/
html.dark-mode #nav-tree {
	background: transparent;
}

html.dark-mode #nav-tree .selected {
	background-image: none;
	background: #32363d;
}

/*********************************************/
/**               Main content              **/
/*********************************************/

/*********************************************/
/**               Inline code               **/
/*********************************************/
html.dark-mode p code,
html.dark-mode li code,
html.dark-mode td code,
html.dark-mode dd code {
	background-color: #000000;
	border: 1px solid #A8B8D9;

	color: #D8D8D8;
}

/*********************************************/
/**         Table of Contents (ToC)         **/
/*********************************************/
html.dark-mode div.toc {
	background: #32363d;
	border: 1px solid #000000;
}

html.dark-mode div.toc h3 {
	font-size: 150%;
	color: inherit;
}

/*********************************************/
/**              Content table              **/
/*********************************************/
html.dark-mode table.doxtable tr:nth-child(even) td {
	background: #32363d;
}

html.dark-mode div.header {
	background: transparent;
	border-bottom: 1px solid #32363d;
}

/*********************************************/
/**               Field table               **/
/*********************************************/
html.dark-mode .fieldtable th {
	background: #282923;
	color: inherit;
}

/*********************************************/
/**           Memitem and memtitle          **/
/*********************************************/
html.dark-mode .memdoc {
	border: 1px solid #A8B8D9;
}

/*********************************************/
/**             TOP navigation              **/
/*********************************************/
html.dark-mode .tabs, html.dark-mode .tabs2, html.dark-mode .tabs3 {
	background: #DDDDDD;
}

html.dark-mode .tablist li {
	background: transparent !important;
}

html.dark-mode .tablist a {
	background-image: none;
	border-right: 1px solid #999999;

	color: #32363d;
}

html.dark-mode .tablist a:hover,
html.dark-mode .tablist li.current a {
	text-decoration: none;
	color: #000000;
	background: #CCCCCC;
	background-image: none;
}

/*********************************************/
/**               Note, warning             **/
/*********************************************/
html.dark-mode #docs_list {
	background: #32363d;
}

html.dark-mode #docs_list ul li {
	border-right: 1px solid #BFBFBF;
}

html.dark-mode #docs_list ul li a {
	color: #1b1e21;
}

html.dark-mode #docs_list ul li a:hover,
html.dark-mode #docs_list ul li a.docs_current {
	background: #282923;
}

/*********************************************/
/**               Resizable UI              **/
/*********************************************/
html.dark-mode .ui-resizable-e {
	background: #32363d;
}

/*********************************************/
/**               Syntax folor              **/
/*********************************************/
html.dark-mode div.line {
	background: transparent;
	color: #d7d7d7;
}

html.dark-mode div.line a {
	color: inherit;
}

html.dark-mode span.keyword {
	color: #f92472;
	font-style: italic;
}

html.dark-mode span.keywordtype {
	color: #67cfc1;
	font-style: italic;
}

html.dark-mode span.keywordflow {
	color: #f92472;
	font-style: italic;
}

html.dark-mode span.comment {
	color: #74705a;
}

html.dark-mode span.preprocessor {
	color: #a6e22b;
}

html.dark-mode span.stringliteral {
	color: #e7db74;
}

html.dark-mode span.charliteral {
	color: #e7db74;
}

html.dark-mode span.vhdldigit { 
	color: #ff00ff;
}

html.dark-mode span.vhdlchar { 
	color: #000000;
}

html.dark-mode span.vhdlkeyword { 
	color: #700070;
}

html.dark-mode span.vhdllogic { 
	color: #ff0000;
}

html.dark-mode span.lineno {
	background: transparent;
}

html.dark-mode span.lineno a {
	background: transparent;
}

/*********************************************/
/**          Modules/Directory table        **/
/*********************************************/
html.dark-mode .mdescLeft, html.dark-mode .mdescRight, html.dark-mode .memItemLeft, html.dark-mode .memItemRight,
html.dark-mode .memTemplItemLeft, html.dark-mode .memTemplItemRight, html.dark-mode .memTemplParams {
	background: #32363d;
	color: inherit;
}

html.dark-mode .memtemplate {
	color: #B4CCF9;
}

html.dark-mode .memSeparator {
	border: none;
	background: transparent;
}

html.dark-mode h2.groupheader {
	color: #67d8ef;
}

/*********************************************/
/**                 Mem items               **/
/*********************************************/
html.dark-mode .memtitle {
	background: #32363d !important;
	border-color: #000000;
}

html.dark-mode .memitem {
	background: #32363d !important;
	color: inherit;
	text-shadow: none;
}

html.dark-mode .memproto {
	background: inherit;
	border-color: #000000;
	color: inherit;
	text-shadow: none;
}

html.dark-mode .memproto table td {
	font-family: monospace, fixed !important;
}

html.dark-mode td.memItemLeft, html.dark-mode td.memItemRight {
	font-family: monospace, fixed;
}

html.dark-mode .paramname, html.dark-mode .paramname em {
	color: #bf5f82;
}

html.dark-mode .memdoc {
	background: inherit;
	border-color: #000000;
}


/*********************************************/
/**                 Footer                  **/
/*********************************************/
html.dark-mode .titlearea {
	border-bottom: 1px solid #32363d;
}

html.dark-mode #nav-path {
	background: transparent;
}

html.dark-mode #nav-path ul {
	background: transparent;
	color: inherit;
	border: none;
	border-top: 1px solid #32363d;
}

html.dark-mode .navpath li.footer {
	color: inherit;
}

html.dark-mode .navpath li.navelem a {
	text-shadow: none;
}

/*********************************************/
/**             Custom scrollbar            **/
/*********************************************/
html.dark-mode ::-webkit-scrollbar {
	width: 10px;
}

/* Track */
html.dark-mode ::-webkit-scrollbar-track {
	border-radius: 10px;
}
 
/* Handle */
html.dark-mode ::-webkit-scrollbar-thumb {
	background: #234567;
	border: none;
}

/* Handle on hover */
html.dark-mode ::-webkit-scrollbar-thumb:hover {
	background: #32363d; 
}

/*********************************************/
/**             Glow effect                 **/
/*********************************************/
html.dark-mode h1.glow, html.dark-mode h2.glow, html.dark-mode h3.glow,
html.dark-mode h4.glow, html.dark-mode h5.glow, html.dark-mode h6.glow {
	text-shadow: 0 0 15px #67d8ef;
}

/*********************************************/
/**   Transparent background for dot/graphviz **/
/**   diagrams (inheritance, collaboration)   **/
/*********************************************/
html.dark-mode .dyncontent iframe,
html.dark-mode .zoom iframe {
	background: transparent;
}
